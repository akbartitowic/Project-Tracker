APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match your public site URL in production (e.g. https://tracker.example.com)
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# SaaS: root domain for tenant subdomains (e.g. hubtask.id for prod, hubtask.test for local Valet)
# Tenants are accessed via: {slug}.APP_DOMAIN
APP_DOMAIN=hubtask.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SaaS: set to .hubtask.id (with leading dot) so session is shared across all subdomains
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Company logos are stored under storage/app/public. After each deploy run once:
#   php artisan storage:link
# Ensure storage/app/public is persisted (not wiped on redeploy).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Must match APP_DOMAIN — used by frontend for subdomain routing and org redirect
VITE_APP_DOMAIN="${APP_DOMAIN}"

# Public self-registration (disabled by default in production)
ALLOW_PUBLIC_SIGNUP=false

# API token lifetime in minutes (12 hours); tokens also expire when the calendar day changes
SANCTUM_TOKEN_EXPIRATION_MINUTES=720
